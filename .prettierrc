{
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "printWidth": 100,

  "overrides": [
    {
      "files": ["*.scss"],
      "options": {
        "tabWidth": 4,
        "singleQuote": false,
        "printWidth": 100,
        "proseWrap": "preserve"
      }
    }
  ]
}
