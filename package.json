{
  "name": "demo-cms-panel",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "watch:sass": "sass --quiet-deps --no-source-map --watch assets/sass:assets/css",
    "watch:css": "postcss \"assets/css/**/*.css\" --dir assets/css --watch",
    "dev": "concurrently -k \"npm run watch:sass\" \"npm run watch:css\"",
    "build:sass": "sass --quiet-deps assets/sass:assets/css --style=compressed",
    "build:css": "postcss \"assets/css/**/*.css\" --replace",
    "build": "npm run build:sass && npm run build:css"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.7.4",
    "sass": "^1.96.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-scss": "^6.13.0"
  },
  "stylelint": {
    "customSyntax": "postcss-scss",
    "plugins": [
      "stylelint-scss"
    ],
    "rules": {
      "at-rule-no-unknown": null,
      "scss/at-rule-no-unknown": true,
      "selector-class-pattern": null,
      "scss/at-mixin-pattern": null,
      "scss/dollar-variable-pattern": null,
      "at-rule-empty-line-before": "never",
      "rule-empty-line-before": "never-multi-line",
      "declaration-property-value-no-unknown": null
    }
  }
}
